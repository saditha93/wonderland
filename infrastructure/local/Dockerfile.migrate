FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock && useradd --uid 10001 --create-home appuser
COPY wonderland_common /app/wonderland_common
COPY scripts/db_migrate.py /app/scripts/db_migrate.py
COPY scripts/cloud_migrate.py /app/scripts/cloud_migrate.py
COPY services/attractions-service/migrations /app/services/attractions-service/migrations
COPY services/booking-service/migrations /app/services/booking-service/migrations
COPY services/gate-ride-service/migrations /app/services/gate-ride-service/migrations
COPY services/analytics-worker/migrations /app/services/analytics-worker/migrations
USER 10001
CMD ["python", "scripts/db_migrate.py", "--seed"]

# Reference only. Prefer scripts/local-postgres.py or scripts/configure-compose.py
# to generate unique local credentials in ignored secrets/*.env files.
APP_ENVIRONMENT=local
APP_VERSION=0.2.0
APP_AUTH_MODE=disabled
# Protected APIs fail closed until local auth is explicitly configured.
# APP_AUTH_SECRET=<generated-secret-at-least-32-characters>
# APP_TICKET_SECRET=<different-generated-secret>
# APP_LOCAL_WEBHOOK_SECRET=<different-generated-secret>
# APP_DATABASE_URL=postgresql+psycopg://<service-role>:<password>@127.0.0.1:55432/wonderland
APP_PAYMENT_PROVIDER=local
APP_FRONTEND_URL=http://localhost:5173

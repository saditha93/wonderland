{
  "name": "wonderland-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin",
    "build": "tsc --noEmit && vite build && vite build --mode admin",
    "build:visitor": "tsc --noEmit && vite build",
    "build:admin": "tsc --noEmit && vite build --mode admin",
    "preview": "vite preview",
    "preview:admin": "vite preview --mode admin --port 4174",
    "format": "prettier --write src vite.config.ts index.html admin/index.html",
    "format:check": "prettier --check src vite.config.ts index.html admin/index.html"
  },
  "dependencies": {
    "aws-amplify": "6.22.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
